{
  "name": "restovyn-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade internal restaurant management and POS platform",
  "author": "Ratnadeep Parya",
  "license": "UNLICENSED",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @restovyn/api db:generate",
    "db:migrate": "pnpm --filter @restovyn/api db:migrate",
    "db:seed": "pnpm --filter @restovyn/api db:seed"
  },
  "devDependencies": {
    "@prisma/client": "^6.4.1",
    "prisma": "^6.4.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "prettier": "^3.5.1"
  },
  "packageManager": "pnpm@11.15.1"
}
