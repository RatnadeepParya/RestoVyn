# Node Environment
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Primary PostgreSQL Database
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://restovyn:resto_secret_pass@localhost:5432/restovyn_db?schema=public

# Redis Cache & WebSockets
REDIS_URL=redis://localhost:6379

# Centralized Authentication & Security
AUTH_PROVIDER=jwt
JWT_SECRET=your_super_secret_jwt_access_token_key_min_32_chars_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_min_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d
PIN_SALT_ROUNDS=10

# Cloud & Storage Abstraction (local | s3 | gcs | azure | firebase)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# AWS Configuration (when STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=restovyn-assets

# GCP Configuration (when STORAGE_PROVIDER=gcs)
GCP_PROJECT_ID=
GCS_BUCKET=restovyn-bucket

# Azure Configuration (when STORAGE_PROVIDER=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER=restovyn-files

# Notifications Provider (fcm | sns | smtp | sendgrid)
NOTIFICATION_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@restovyn.internal

# Payment Provider (manual | razorpay)
PAYMENT_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Printer Provider (local | network | usb)
PRINTER_PROVIDER=local

# Restaurant Defaults
RESTAURANT_TIMEZONE=Asia/Kolkata
BUSINESS_DAY_CUTOFF=06:00
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹
